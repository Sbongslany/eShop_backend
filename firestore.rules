rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.role == 'super_admin' || 
              request.auth.token.role == 'admin' || 
              request.auth.token.role == 'support');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // 1. NOTIFICATIONS (Activity Center)
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // 2. SAVED VIEWS (Filters for Catalogs/Queues)
    match /saved_views/{viewId} {
      allow read: if isAdmin() && 
                  (resource.data.isGlobal == true || resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() && resource.data.ownerUid == request.auth.uid;
    }

    // 3. CUSTOMERS (User Profiles)
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow update: if isOwner(customerId);
      allow create: if false; // Only backend can create (via auth trigger)
      allow delete: if hasRole('super_admin');

      // 3a. ADDRESSES (Subcollection)
      match /addresses/{addressId} {
        allow read: if isOwner(customerId) || isAdmin();
        allow create, update, delete: if isOwner(customerId);
      }

      // 3b. WISHLISTS (Subcollection)
      match /wishlists/{wishlistItemId} {
        allow read: if isOwner(customerId);
        allow create, update, delete: if isOwner(customerId);
      }
    }

    // 4. AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend can write (Cloud Functions)
    }

    // 5. ORDERS (Granular Rules)
    match /orders/{orderId} {
      // Anyone can create an order (handled securely via createOrder callable function)
      allow create: if request.resource.data.customerEmail != null;
      
      // Customers can read their own orders, admins can read all
      allow read: if isAuthenticated() && 
                  (resource.data.customerId == request.auth.uid || isAdmin());
                  
      // Only admins or backend (via webhooks/triggers) can update/delete orders
      allow update, delete: if isAdmin();
    }

    // 5a. RETURNS / RMA
    match /returns/{returnId} {
      // Customers can read their own returns, admins can read all
      allow read: if isAuthenticated() && 
                  (resource.data.customerId == request.auth.uid || isAdmin());
      
      // Customers can create returns (handled securely via requestReturn callable function)
      allow create: if isAuthenticated();
      
      // Only admins can update or delete returns (via updateReturnStatus callable function)
      allow update, delete: if isAdmin();
    }

    // 6. PRODUCTS
    match /products/{productId} {
      allow read: if true; // Storefront needs to read active products
      allow write: if hasRole('super_admin') || hasRole('admin');
    }

    // 7. CATEGORIES
    match /categories/{categoryId} {
      allow read: if true; // Anyone can read categories (needed for storefront)
      allow create, update, delete: if hasRole('super_admin') || hasRole('admin');
    }

    // 8. ADMINS TRACKING (For RBAC management)
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin');
    }

    // 9. WAREHOUSES (Admin Only)
    match /warehouses/{warehouseId} {
      allow read: if isAdmin();
      allow create, update, delete: if hasRole('super_admin') || hasRole('admin');
    }

    // 10. INVENTORY RECORDS (Admin reads/writes)
    match /inventory/{inventoryId} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin') || hasRole('admin');
    }

    // 11. STOCK RESERVATIONS (Backend only for writes, users can read their own)
    match /stock_reservations/{reservationId} {
      allow read: if isAuthenticated() && 
                  (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false; // Only backend (Cloud Functions) can write reservations
    }

    // 12. CARTS (Users can read/write their own, guests via sessionId)
    match /carts/{cartId} {
      // Authenticated users can only access their own cart
      allow read, write: if isAuthenticated() && 
                         (resource.data.customerId == request.auth.uid || 
                          request.resource.data.customerId == request.auth.uid);
      
      // For guest carts (cartId starts with "guest_"), allow access
      allow read, write: if cartId.startsWith("guest_");
    }

    // 13. PROMO CODES (Anyone can read active codes, only admins can manage)
    match /promo_codes/{promoId} {
      allow read: if true; // Storefront needs to validate codes
      allow create, update, delete: if hasRole('super_admin') || hasRole('admin');
    }

    // Deny access to everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}