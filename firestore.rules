rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.role == 'super_admin' || 
              request.auth.token.role == 'admin' || 
              request.auth.token.role == 'support');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // 1. NOTIFICATIONS (Activity Center)
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // 2. SAVED VIEWS (Filters for Catalogs/Queues)
    match /saved_views/{viewId} {
      allow read: if isAdmin() && 
                  (resource.data.isGlobal == true || resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() && resource.data.ownerUid == request.auth.uid;
    }

    // 3. CUSTOMERS (User Profiles)
    match /customers/{customerId} {
      // Customers can read their own profile, admins can read all
      allow read: if isOwner(customerId) || isAdmin();
      
      // Customers can update their own profile
      allow update: if isOwner(customerId);
      
      // Only backend can create (via auth trigger)
      allow create: if false;
      
      // Only super admins can delete customers
      allow delete: if hasRole('super_admin');

      // 3a. ADDRESSES (Subcollection)
      match /addresses/{addressId} {
        allow read: if isOwner(customerId) || isAdmin();
        allow create, update, delete: if isOwner(customerId);
      }

      // 3b. WISHLISTS (Subcollection)
      match /wishlists/{wishlistItemId} {
        allow read: if isOwner(customerId);
        allow create, update, delete: if isOwner(customerId);
      }
    }

    // 4. AUDIT LOGS
    match /audit_logs/{logId} {
      // Only admins can read audit logs
      allow read: if isAdmin();
      
      // Only backend can write (Cloud Functions)
      allow write: if false;
    }

    // 5. CORE DATA (Orders & Products)
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

        // 5. CATEGORIES
    match /categories/{categoryId} {
      allow read: if true; // Anyone can read categories (needed for storefront)
      allow create, update, delete: if hasRole('super_admin') || hasRole('admin');
    }

    // 6. CORE DATA (Orders & Products)
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true; // Anyone can read active products
      allow write: if hasRole('super_admin') || hasRole('admin');
    }

    match /products/{productId} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin') || hasRole('admin');
    }
    
    // 6. ADMINS TRACKING (For RBAC management)
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin');
    }

    // Deny access to everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}