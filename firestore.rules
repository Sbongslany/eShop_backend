rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user has a specific admin role in their Custom Claims
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    // Check if user is any type of admin
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.role == 'super_admin' || 
              request.auth.token.role == 'admin' || 
              request.auth.token.role == 'support');
    }

    // --- COLLECTION RULES ---

    // 1. NOTIFICATIONS (Activity Center)
    // Admins can read them. ONLY Cloud Functions (backend) can write them.
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      
      // Prevent frontend from creating, updating, or deleting notifications directly.
      // They must be generated by Cloud Functions triggers (which use the Admin SDK).
      allow write: if false; 
    }

    // 2. SAVED VIEWS (Filters for Catalogs/Queues)
    // Admins can read global views. They can only write/edit/delete their own views.
    match /saved_views/{viewId} {
      allow read: if isAdmin() && 
                  (resource.data.isGlobal == true || resource.data.ownerUid == request.auth.uid);
                  
      allow create: if isAdmin() && request.resource.data.ownerUid == request.auth.uid;
      
      allow update, delete: if isAdmin() && resource.data.ownerUid == request.auth.uid;
    }

    // 3. CORE DATA (Orders & Products)
    // Placeholder rules for Phase 2. We will refine these later.
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin') || hasRole('admin'); // Support can't edit products
    }
    
    // 4. ADMINS TRACKING (For RBAC management)
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin');
    }

    // Deny access to everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}